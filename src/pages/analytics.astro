---
// src/pages/analytics.astro
// Dashboard de analytics — componentes extraídos e seu uso

import AppLayout from '../layouts/AppLayout.astro'
import { Icon } from 'astro-icon/components'
import { loadAnalytics, getAnalyticsSummary, formatDateFull } from '../lib/analytics'

const analyticsData = loadAnalytics()
const summary = getAnalyticsSummary(analyticsData)
---

<AppLayout title="Analytics — Astroteca">
  <main>
    <div class="page-container">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-ink-primary mb-1">Analytics</h1>
        <p class="text-ink-secondary text-sm">Rastreamento de componentes extraídos e seu uso em projetos</p>
      </div>

      <!-- Cards de Resumo -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div class="card">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-ink-secondary text-xs uppercase tracking-wider font-medium mb-1">Total de Componentes</p>
              <p class="text-4xl font-bold text-accent">{summary.totalComponents}</p>
            </div>
            <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center">
              <Icon name="lucide:layers" class="w-6 h-6 text-accent" />
            </div>
          </div>
        </div>

        <div class="card">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-ink-secondary text-xs uppercase tracking-wider font-medium mb-1">Projetos Usando</p>
              <p class="text-4xl font-bold text-ok">{summary.totalProjects}</p>
            </div>
            <div class="w-12 h-12 rounded-lg bg-ok/10 flex items-center justify-center">
              <Icon name="lucide:check-circle" class="w-6 h-6 text-ok" />
            </div>
          </div>
        </div>
      </div>

      <!-- Componentes Mais Usados -->
      {summary.mostUsed.length > 0 && (
        <div class="card mb-8">
          <h2 class="text-xl font-bold text-ink-primary mb-6">Top 5 — Mais Usados</h2>
          <div class="space-y-3">
            {summary.mostUsed.map((comp, idx) => (
              <div class="flex items-center justify-between p-3 rounded-lg bg-raised hover:bg-hover transition-colors">
                <div class="flex items-center gap-3">
                  <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-accent/20 text-accent font-semibold text-sm">
                    {idx + 1}
                  </div>
                  <div>
                    <p class="font-medium text-ink-primary">{comp.name}</p>
                    <p class="text-xs text-ink-secondary">{comp.category}</p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="font-bold text-ok text-lg">{comp.totalProjects}</p>
                  <p class="text-xs text-ink-secondary">projetos</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Extrações Recentes -->
      {summary.recentExtractions.length > 0 && (
        <div class="card mb-8">
          <h2 class="text-xl font-bold text-ink-primary mb-6">Extrações Recentes</h2>
          <div class="space-y-2">
            {summary.recentExtractions.map((comp) => (
              <div class="flex items-center justify-between p-3 rounded-lg bg-raised">
                <div>
                  <p class="font-medium text-ink-primary">{comp.name}</p>
                  <p class="text-xs text-ink-secondary">{comp.category}</p>
                </div>
                <p class="text-xs text-ink-secondary whitespace-nowrap ml-4">{formatDateFull(comp.extractedAt)}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Tabela Completa -->
      {summary.allComponents.length > 0 && (
        <div class="card">
          <h2 class="text-xl font-bold text-ink-primary mb-6">Todos os Componentes</h2>

          <!-- Desktop Table -->
          <div class="hidden md:block overflow-x-auto mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left py-3 px-4 text-ink-secondary font-medium">Nome</th>
                  <th class="text-left py-3 px-4 text-ink-secondary font-medium">Categoria</th>
                  <th class="text-center py-3 px-4 text-ink-secondary font-medium">Projetos</th>
                  <th class="text-left py-3 px-4 text-ink-secondary font-medium">Extraído em</th>
                </tr>
              </thead>
              <tbody>
                {summary.allComponents.map((comp) => (
                  <tr class="border-b border-border hover:bg-raised transition-colors">
                    <td class="py-3 px-4 text-ink-primary font-medium">{comp.name}</td>
                    <td class="py-3 px-4">
                      <span class="px-2 py-1 bg-accent/15 text-accent rounded text-xs font-medium">
                        {comp.category}
                      </span>
                    </td>
                    <td class="py-3 px-4 text-center">
                      <span class="inline-block px-3 py-1 bg-ok/15 text-ok rounded-full text-xs font-semibold">
                        {comp.totalProjects}
                      </span>
                    </td>
                    <td class="py-3 px-4 text-ink-secondary text-xs">{formatDateFull(comp.extractedAt)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Mobile Cards -->
          <div class="md:hidden space-y-3 mb-6">
            {summary.allComponents.map((comp) => (
              <div class="p-4 rounded-lg bg-raised border border-border">
                <div class="flex items-start justify-between mb-2">
                  <p class="font-medium text-ink-primary">{comp.name}</p>
                  <span class="inline-block px-2 py-1 bg-ok/15 text-ok rounded text-xs font-semibold">
                    {comp.totalProjects}
                  </span>
                </div>
                <p class="text-xs text-ink-secondary mb-2">
                  <span class="px-2 py-1 bg-accent/15 text-accent rounded inline-block">{comp.category}</span>
                </p>
                <p class="text-xs text-ink-secondary">{formatDateFull(comp.extractedAt)}</p>
              </div>
            ))}
          </div>

          <!-- Expandable: Mostrar projetos por componente -->
          {summary.allComponents.some(c => c.usedIn.length > 0) && (
            <details class="mt-6 pt-6 border-t border-border">
              <summary class="cursor-pointer font-medium text-ink-primary hover:text-accent transition-colors flex items-center gap-2">
                <Icon name="lucide:chevron-down" class="w-4 h-4 transition-transform" />
                Ver projetos por componente
              </summary>
              <div class="space-y-4 mt-6">
                {summary.allComponents
                  .filter((comp) => comp.usedIn.length > 0)
                  .map((comp) => (
                    <div class="p-4 rounded-lg bg-raised border border-border">
                      <h3 class="font-medium text-ink-primary mb-3">{comp.name}</h3>
                      <ul class="space-y-2">
                        {comp.usedIn.map((usage) => (
                          <li class="text-sm text-ink-secondary flex justify-between items-center">
                            <code class="bg-border px-2 py-1 rounded text-xs font-mono text-accent">{usage.projectName}</code>
                            <span class="text-xs text-ink-muted">{formatDateFull(usage.date)}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
              </div>
            </details>
          )}
        </div>
      )}

      <!-- Vazio -->
      {summary.allComponents.length === 0 && (
        <div class="card text-center py-16">
          <Icon name="lucide:mail" class="w-10 h-10 text-ink-muted mx-auto mb-3 opacity-40" />
          <p class="font-medium text-ink-primary mb-1">Nenhum componente extraído ainda</p>
          <p class="text-sm text-ink-secondary">Os componentes aparecerão aqui quando você extrair o primeiro</p>
        </div>
      )}
    </div>
  </main>
</AppLayout>

<style>
  .page-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
  }

  .card:hover {
    border-color: var(--border-subtle);
    background: var(--raised);
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 2rem 1rem;
    }

    .card {
      padding: 1.25rem;
    }
  }
</style>
