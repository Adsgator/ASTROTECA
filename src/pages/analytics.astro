---
// src/pages/analytics.astro
// Dashboard de analytics — componentes extraídos e seu uso

import AppLayout from '../layouts/AppLayout.astro'
import { loadAnalytics, getAnalyticsSummary, formatDate } from '../lib/analytics'

const analyticsData = loadAnalytics()
const summary = getAnalyticsSummary(analyticsData)
---

<AppLayout title="Analytics — Astroteca">
  <main class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 py-12">
      <!-- Header -->
      <div class="mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">📊 Analytics</h1>
        <p class="text-gray-600">Rastreamento de componentes extraídos e seu uso em projetos</p>
      </div>

      <!-- Cards de Resumo -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Total de Componentes</p>
              <p class="text-4xl font-bold text-gray-900 mt-2">{summary.totalComponents}</p>
            </div>
            <div class="text-5xl text-blue-500">📦</div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Projetos Usando</p>
              <p class="text-4xl font-bold text-gray-900 mt-2">{summary.totalProjects}</p>
            </div>
            <div class="text-5xl text-green-500">🚀</div>
          </div>
        </div>
      </div>

      <!-- Componentes Mais Usados -->
      {summary.mostUsed.length > 0 && (
        <div class="bg-white rounded-lg shadow-md p-6 mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">⭐ Top 5 — Mais Usados</h2>
          <div class="space-y-4">
            {summary.mostUsed.map((comp, idx) => (
              <div class="flex items-center justify-between pb-4 border-b border-gray-200 last:border-b-0">
                <div class="flex items-center gap-4">
                  <div class="w-8 h-8 rounded-full bg-blue-500 text-white flex items-center justify-center font-bold text-sm">
                    {idx + 1}
                  </div>
                  <div>
                    <p class="font-semibold text-gray-900">{comp.name}</p>
                    <p class="text-sm text-gray-600">{comp.category}</p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="text-2xl font-bold text-green-600">{comp.totalProjects}</p>
                  <p class="text-xs text-gray-600">projetos</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Extrações Recentes -->
      {summary.recentExtractions.length > 0 && (
        <div class="bg-white rounded-lg shadow-md p-6 mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">🆕 Extrações Recentes</h2>
          <div class="space-y-3">
            {summary.recentExtractions.map((comp) => (
              <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
                <div>
                  <p class="font-semibold text-gray-900">{comp.name}</p>
                  <p class="text-xs text-gray-600">{comp.category}</p>
                </div>
                <p class="text-sm text-gray-600">{formatDate(comp.extractedAt)}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Tabela Completa -->
      {summary.allComponents.length > 0 && (
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <div class="p-6 border-b border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900">📋 Todos os Componentes</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-100 border-b border-gray-200">
                <tr>
                  <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Nome</th>
                  <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Categoria</th>
                  <th class="px-6 py-3 text-center text-sm font-semibold text-gray-900">Projetos</th>
                  <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Extraído em</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                {summary.allComponents.map((comp) => (
                  <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 text-sm font-medium text-gray-900">{comp.name}</td>
                    <td class="px-6 py-4 text-sm text-gray-600">
                      <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs font-medium">
                        {comp.category}
                      </span>
                    </td>
                    <td class="px-6 py-4 text-sm text-center">
                      <span class="inline-block px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-semibold">
                        {comp.totalProjects}
                      </span>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600">
                      {formatDate(comp.extractedAt)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Expandable: Mostrar projetos por componente -->
          <div class="p-6 border-t border-gray-200 bg-gray-50">
            <details class="space-y-4">
              <summary class="cursor-pointer font-semibold text-gray-900 hover:text-gray-600">
                📍 Ver projetos por componente
              </summary>
              <div class="space-y-6 pt-4">
                {summary.allComponents
                  .filter((comp) => comp.usedIn.length > 0)
                  .map((comp) => (
                    <div class="bg-white p-4 rounded border border-gray-200">
                      <h3 class="font-semibold text-gray-900 mb-3">{comp.name}</h3>
                      <ul class="space-y-2">
                        {comp.usedIn.map((usage) => (
                          <li class="text-sm text-gray-600 flex justify-between">
                            <span>
                              <code class="bg-gray-100 px-2 py-1 rounded text-xs">{usage.projectName}</code>
                            </span>
                            <span class="text-xs text-gray-500">{formatDate(usage.date)}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
              </div>
            </details>
          </div>
        </div>
      )}

      <!-- Vazio -->
      {summary.allComponents.length === 0 && (
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
          <p class="text-2xl text-gray-600 mb-2">📭 Nenhum componente extraído ainda</p>
          <p class="text-gray-500">Os componentes aparecerão aqui quando você extrair o primeiro</p>
        </div>
      )}
    </div>
  </main>
</AppLayout>
