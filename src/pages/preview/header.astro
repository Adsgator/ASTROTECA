---
import Header from '../../../minha-lib-astro/src/components/Header/Header.astro'
import PreviewLayout from '../../layouts/PreviewLayout.astro'
---

<PreviewLayout title="Header — Preview">
  <Header
    logo="Joao Silva"
    links={[
      { label: "Inicio", href: "#inicio" },
      { label: "Servicos", href: "#servicos" },
      { label: "Sobre", href: "#sobre" },
      { label: "Contato", href: "#contato" },
    ]}
    ctaLabel="Fale comigo"
    ctaHref="#contato"
  />
  <section id="inicio" style="height:100vh;display:flex;align-items:center;justify-content:center;padding-top:var(--header-height);">
    <p style="color:var(--color-text-muted)">Role para ver o header esconder/reaparecer e os links ativarem.</p>
  </section>
  <section id="servicos" style="height:100vh"></section>
  <section id="sobre" style="height:100vh"></section>
  <section id="contato" style="height:100vh"></section>
</PreviewLayout>
