---
// PreviewLayout — contexto isolado para preview de componentes da biblioteca.
// Carrega preview-components.css (compilado de tailwind-tokens.js + global utilities)
// e NÃO herda o tema dark do Astroteca. O que você vê aqui = o que o cliente vê.

interface Props {
  title?: string
  /** Fontes adicionais para carregar no preview (URL do Google Fonts) */
  fontsUrl?: string
}

const { title = 'Preview', fontsUrl } = Astro.props
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  {/* Fontes padrão do sistema — Cormorant (serif) + DM Sans (sans) */}
  {fontsUrl
    ? <link rel="stylesheet" href={fontsUrl} />
    : <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
      />
  }

  {/* CSS compilado dos tokens do projeto cliente — isolado do tema dark do Astroteca */}
  <link rel="stylesheet" href="/preview-components.css" />

  {/* Tokens em CSS custom properties da biblioteca (Tailwind v4) —
      garante que var(--color-*), var(--font-*) etc. existam no preview */}
  <style is:global>
    @import '../../minha-lib-astro/src/styles/base.css';
  </style>
</head>
<body>
  <slot />
</body>
</html>
