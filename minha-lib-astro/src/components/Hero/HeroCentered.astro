---
// src/components/Hero/HeroCentered.astro

interface Props {
  headline: string
  subheadline?: string
  ctaLabel?: string
  ctaHref?: string
}

const {
  headline,
  subheadline = '',
  ctaLabel = 'Comecar agora',
  ctaHref = '#',
} = Astro.props
---

<section class="hero hero--centered">
  <div class="hero__content">
    <h1 class="hero__headline">{headline}</h1>
    {subheadline && <p class="hero__subheadline">{subheadline}</p>}
    <a href={ctaHref} class="btn btn--primary">{ctaLabel}</a>
  </div>
</section>

<style>
  .hero--centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-2xl, 6rem) var(--container-padding, 1.5rem);
    max-width: var(--container-max, 1200px);
    margin: 0 auto;
    min-height: 60vh;
  }

  .hero__headline {
    font-family: var(--font-heading, serif);
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: var(--color-heading, #111);
    line-height: 1.1;
    margin-bottom: 1rem;
    max-width: 800px;
  }

  .hero__subheadline {
    font-size: 1.25rem;
    color: var(--color-text-muted, #555);
    margin-bottom: 2rem;
    line-height: 1.6;
    max-width: 600px;
  }

  .btn--primary {
    display: inline-block;
    background: var(--color-primary, #333);
    color: var(--color-on-primary, #fff);
    padding: 0.875rem 2rem;
    border-radius: var(--radius, 6px);
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .btn--primary:hover {
    opacity: 0.88;
  }
</style>
