---
// src/components/Hero/HeroCentered.astro

interface Props {
  headline: string
  subheadline?: string
  ctaLabel?: string
  ctaHref?: string
}

const {
  headline,
  subheadline = '',
  ctaLabel = 'Comecar agora',
  ctaHref = '#',
} = Astro.props
---

<section class="flex flex-col items-center justify-center text-center min-h-[60vh] py-16 lg:py-24 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
  <div class="space-y-6">
    <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight max-w-3xl mx-auto">
      {headline}
    </h1>
    {subheadline && (
      <p class="text-lg sm:text-xl text-gray-600 leading-relaxed max-w-xl mx-auto">
        {subheadline}
      </p>
    )}
    <a
      href={ctaHref}
      class="inline-flex items-center px-8 py-3.5 bg-primary text-white font-semibold rounded-lg hover:opacity-90 transition-opacity"
    >
      {ctaLabel}
    </a>
  </div>
</section>
