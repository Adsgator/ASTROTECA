---
// src/components/Hero/HeroCentered.astro

interface Props {
  headline: string
  subheadline?: string
  ctaLabel?: string
  ctaHref?: string
}

const {
  headline,
  subheadline = '',
  ctaLabel = 'Comecar agora',
  ctaHref = '#',
} = Astro.props
---

<section class="flex flex-col items-center justify-center text-center py-24 px-6 max-w-[900px] mx-auto">
  <h1 class="font-serif text-[clamp(2rem,5vw,3.5rem)] text-text-main leading-[1.1] mb-6">
    {headline}
  </h1>
  {subheadline && (
    <p class="text-lg sm:text-xl text-text-soft mb-8 leading-relaxed max-w-[600px]">
      {subheadline}
    </p>
  )}
  <a href={ctaHref} class="btn-primary">
    {ctaLabel}
  </a>
</section>
