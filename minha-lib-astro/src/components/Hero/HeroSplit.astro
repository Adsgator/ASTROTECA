---
// src/components/Hero/HeroSplit.astro

interface Props {
  headline: string
  subheadline?: string
  ctaLabel?: string
  ctaHref?: string
  imageSrc?: string
}

const {
  headline,
  subheadline = '',
  ctaLabel = 'Saiba mais',
  ctaHref = '#contato',
  imageSrc,
} = Astro.props
---

<section class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center py-24 px-6 max-w-content mx-auto">
  <div>
    <h1 class="font-serif text-[clamp(2rem,5vw,3.5rem)] text-text-main leading-[1.1] mb-4">
      {headline}
    </h1>
    {subheadline && (
      <p class="text-lg text-text-soft mb-8 leading-relaxed">
        {subheadline}
      </p>
    )}
    <a href={ctaHref} class="btn-primary">
      {ctaLabel}
    </a>
  </div>

  {imageSrc && (
    <div>
      <img
        src={imageSrc}
        alt=""
        class="w-full h-auto rounded-2xl object-cover"
        loading="eager"
      />
    </div>
  )}
</section>
