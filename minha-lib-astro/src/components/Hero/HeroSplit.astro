---
// src/components/Hero/HeroSplit.astro

interface Props {
  headline: string
  subheadline?: string
  ctaLabel?: string
  ctaHref?: string
  imageSrc?: string
}

const {
  headline,
  subheadline = '',
  ctaLabel = 'Saiba mais',
  ctaHref = '#contato',
  imageSrc,
} = Astro.props
---

<section class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center py-16 lg:py-24 px-4 sm:px-6 lg:px-8 xl:px-12 max-w-7xl mx-auto">
  <div class="space-y-6">
    <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight">
      {headline}
    </h1>
    {subheadline && (
      <p class="text-lg sm:text-xl text-gray-600 leading-relaxed max-w-lg">
        {subheadline}
      </p>
    )}
    <a
      href={ctaHref}
      class="inline-flex items-center px-8 py-3.5 bg-primary text-white font-semibold rounded-lg hover:opacity-90 transition-opacity"
    >
      {ctaLabel}
    </a>
  </div>

  {imageSrc && (
    <div class="relative">
      <img
        src={imageSrc}
        alt=""
        class="w-full h-auto rounded-2xl object-cover shadow-xl"
        loading="eager"
      />
    </div>
  )}
</section>
