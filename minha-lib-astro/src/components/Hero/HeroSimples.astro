---
// minha-lib-astro/src/components/Hero/HeroSimples.astro

interface Props {
  headline: string
  subheadline?: string
  ctaLabel?: string
  ctaHref?: string
  badge?: string
}

const {
  headline,
  subheadline = '',
  ctaLabel = 'Saiba mais',
  ctaHref = '#contato',
  badge,
} = Astro.props
---

<section class="py-[clamp(5rem,12vw,10rem)] px-6 bg-background text-center">
  <div class="max-w-[720px] mx-auto">

    {badge && (
      <span class="label-tag mb-6 inline-flex">{badge}</span>
    )}

    <h1 class="font-serif text-[clamp(2.25rem,5vw,4rem)] font-bold text-text-main leading-[1.1] tracking-[-0.02em] mb-5 [&_em]:not-italic [&_em]:text-primary" set:html={headline} />

    {subheadline && (
      <p class="font-sans text-[clamp(1rem,1.5vw,1.2rem)] text-text-soft leading-[1.65] mb-8">
        {subheadline}
      </p>
    )}

    <a href={ctaHref} class="btn-primary">
      {ctaLabel}
    </a>

  </div>
</section>
