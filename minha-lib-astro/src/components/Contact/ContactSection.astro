---
// src/components/Contact/ContactSection.astro

interface ContactInfo {
  icon: string
  label: string
  value: string
  href?: string
}

interface Props {
  sectionTitle?: string
  subtitle?: string
  email?: string
  phone?: string
  whatsapp?: string
  address?: string
  formAction?: string
}

const {
  sectionTitle = "Entre em Contato",
  subtitle = "Preencha o formulario ou use um dos canais abaixo",
  email,
  phone,
  whatsapp,
  address,
  formAction = "#"
} = Astro.props

const contactInfo: ContactInfo[] = [
  email && { icon: "✉️", label: "Email", value: email, href: `mailto:${email}` },
  phone && { icon: "📞", label: "Telefone", value: phone, href: `tel:${phone}` },
  whatsapp && { icon: "💬", label: "WhatsApp", value: whatsapp, href: `https://wa.me/${whatsapp.replace(/\D/g, '')}` },
  address && { icon: "📍", label: "Endereco", value: address },
].filter(Boolean) as ContactInfo[]
---

<section class="py-24 px-6 max-w-content mx-auto bg-surface-alt">
  <div class="text-center mb-12">
    <h2 class="font-serif text-[clamp(1.75rem,4vw,2.5rem)] text-text-main mb-4">{sectionTitle}</h2>
    {subtitle && <p class="text-lg text-text-soft max-w-[600px] mx-auto">{subtitle}</p>}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
    {/* Contact Info */}
    <div class="space-y-6">
      {contactInfo.map((info) => (
        <div class="flex items-start gap-4">
          <span class="text-2xl">{info.icon}</span>
          <div>
            <div class="font-medium text-text-main">{info.label}</div>
            {info.href ? (
              <a href={info.href} class="text-text-soft hover:text-primary transition-colors duration-200 no-underline">
                {info.value}
              </a>
            ) : (
              <div class="text-text-soft">{info.value}</div>
            )}
          </div>
        </div>
      ))}
    </div>

    {/* Form */}
    <form action={formAction} method="POST" class="bg-surface rounded-2xl p-8 shadow-card space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-text-main mb-1">Nome</label>
          <input type="text" name="name" required class="w-full rounded-lg border border-border px-4 py-2 bg-surface text-text-main focus:border-primary focus:outline-none transition-colors duration-200" />
        </div>
        <div>
          <label class="block text-sm font-medium text-text-main mb-1">Email</label>
          <input type="email" name="email" required class="w-full rounded-lg border border-border px-4 py-2 bg-surface text-text-main focus:border-primary focus:outline-none transition-colors duration-200" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-text-main mb-1">Assunto</label>
        <input type="text" name="subject" class="w-full rounded-lg border border-border px-4 py-2 bg-surface text-text-main focus:border-primary focus:outline-none transition-colors duration-200" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text-main mb-1">Mensagem</label>
        <textarea name="message" rows={4} required class="w-full rounded-lg border border-border px-4 py-2 bg-surface text-text-main focus:border-primary focus:outline-none resize-y transition-colors duration-200"></textarea>
      </div>
      <button type="submit" class="btn-primary w-full justify-center">
        Enviar mensagem
      </button>
    </form>
  </div>
</section>
