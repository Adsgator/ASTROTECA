---
// Footer.astro — Rodapé da biblioteca Astroteca
import { Icon } from 'astro-icon/components'
//
// Inclui o toggle de tema (dark mode) em vanilla JS — NÃO é um botão
// flutuante; vive dentro do rodapé. Escreve em localStorage['theme'] e
// aplica/remove a classe .dark no <html>, compatível com o script
// anti-flash que o projeto cliente coloca no <head>.
//
// O <footer> tem id="footer" — usado pelo WhatsAppFloat para esconder
// o botão quando o rodapé está visível.

interface Link {
  label: string;
  href: string;
}
interface SocialLink {
  platform: string;
  href: string;
}

interface Props {
  brandName: string;
  tagline?: string;
  links?: Link[];
  social?: SocialLink[];
  legalLinks?: Link[];
}

const {
  brandName,
  tagline,
  links = [],
  social = [],
  legalLinks = [],
} = Astro.props;

const year = new Date().getFullYear();
---

<footer id="footer" class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <div>
        <h3 class="footer__brand">{brandName}</h3>
        {tagline && <p class="footer__tagline">{tagline}</p>}
      </div>

      {links.length > 0 && (
        <nav class="footer__col" aria-label="Links do rodapé">
          <h4 class="footer__heading">Links</h4>
          {links.map((link) => (
            <a href={link.href} class="footer__link">{link.label}</a>
          ))}
        </nav>
      )}

      {social.length > 0 && (
        <nav class="footer__col" aria-label="Redes sociais">
          <h4 class="footer__heading">Redes sociais</h4>
          {social.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="footer__link">
              {s.platform}
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">© {year} {brandName}. Todos os direitos reservados.</p>

      <div class="footer__bottom-right">
        {legalLinks.length > 0 && (
          <div class="footer__legal">
            {legalLinks.map((link) => (
              <a href={link.href} class="footer__link footer__link--small">{link.label}</a>
            ))}
          </div>
        )}

        <button
          type="button"
          class="footer__theme"
          aria-label="Alternar tema claro/escuro"
          data-theme-toggle
        >
          <span data-theme-icon aria-hidden="true">
            <Icon data-icon-dark name="lucide:moon" class="footer__theme-icon" />
            <Icon data-icon-light name="lucide:sun" class="footer__theme-icon" style="display:none" />
          </span>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--t-dark);
    color: oklch(95% 0.005 260);
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 5vw, 2rem) 2rem;
  }
  .footer__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .footer__brand {
    font-family: var(--t-font-serif);
    font-size: 1.5rem;
    color: oklch(98% 0.005 260);
    margin-bottom: 0.5rem;
  }
  .footer__tagline {
    font-size: 0.9rem;
    color: oklch(75% 0.01 260);
    max-width: 32ch;
  }
  .footer__heading {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: oklch(70% 0.01 260);
    margin-bottom: 1rem;
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer__link {
    font-size: 0.9rem;
    color: oklch(80% 0.01 260);
    transition: color 150ms ease-out;
  }
  .footer__link:hover { color: oklch(98% 0.005 260); }
  .footer__link--small { font-size: 0.72rem; }

  .footer__bottom {
    border-top: 1px solid oklch(100% 0 0 / 0.1);
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .footer__copy {
    font-size: 0.72rem;
    color: oklch(70% 0.01 260);
  }
  .footer__bottom-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .footer__legal {
    display: flex;
    gap: 1.25rem;
  }
  .footer__theme {
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: oklch(100% 0 0 / 0.08);
    border: 1px solid oklch(100% 0 0 / 0.15);
    cursor: pointer;
    transition: background-color 150ms ease-out;
  }
  .footer__theme:hover { background-color: oklch(100% 0 0 / 0.16); }
  .footer__theme-icon { width: 1rem; height: 1rem; color: oklch(90% 0.01 260); }

  @media (min-width: 768px) {
    .footer__grid { grid-template-columns: 2fr 1fr 1fr; }
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const icon = document.querySelector<HTMLElement>("[data-theme-icon]");

  function currentTheme(): "light" | "dark" {
    return document.documentElement.classList.contains("dark") ? "dark" : "light";
  }
  function syncIcon() {
    if (!icon) return
    const iconDark = icon.querySelector<SVGElement>('[data-icon-dark]')
    const iconLight = icon.querySelector<SVGElement>('[data-icon-light]')
    const isDark = currentTheme() === "dark"
    if (iconDark) iconDark.style.display = isDark ? 'none' : 'block'
    if (iconLight) iconLight.style.display = isDark ? 'block' : 'none'
  }

  if (toggle) {
    syncIcon();
    toggle.addEventListener("click", () => {
      const next = currentTheme() === "dark" ? "light" : "dark";
      document.documentElement.classList.toggle("dark", next === "dark");
      localStorage.setItem("theme", next);
      syncIcon();
    });
  }
</script>
