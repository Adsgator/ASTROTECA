---
// src/components/Footer/FooterSimples.astro

interface Link {
  label: string
  href: string
}

interface SocialLink {
  platform: string
  href: string
  icon: string
}

interface Props {
  brandName: string
  tagline?: string
  links?: Link[]
  socialLinks?: SocialLink[]
  bottomLinks?: Link[]
}

const { 
  brandName, 
  tagline, 
  links = [], 
  socialLinks = [], 
  bottomLinks = [] 
} = Astro.props
---

<footer class="bg-gray-900 text-white py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      {/* Brand */}
      <div>
        <h3 class="text-xl font-bold mb-2">{brandName}</h3>
        {tagline && <p class="text-gray-400 text-sm">{tagline}</p>}
      </div>
      
      {/* Links */}
      {links.length > 0 && (
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-wide text-gray-400 mb-4">Links</h4>
          <ul class="space-y-2">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-gray-300 hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      
      {/* Social */}
      {socialLinks.length > 0 && (
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-wide text-gray-400 mb-4">Redes Sociais</h4>
          <div class="flex gap-4">
            {socialLinks.map((social) => (
              <a 
                href={social.href} 
                target="_blank" 
                rel="noopener"
                class="text-2xl hover:opacity-80 transition-opacity"
                title={social.platform}
              >
                {social.icon}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
    
    {/* Bottom */}
    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-400 text-sm">
        © {new Date().getFullYear()} {brandName}. Todos os direitos reservados.
      </p>
      {bottomLinks.length > 0 && (
        <div class="flex gap-6">
          {bottomLinks.map((link) => (
            <a href={link.href} class="text-gray-400 text-sm hover:text-white transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</footer>
