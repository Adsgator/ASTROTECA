---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  dark?: boolean;
  titleMaxWidth?: string;
  labelColor?: string;
}

const { label, title, subtitle, align = 'center', dark = false, titleMaxWidth = 'max-w-3xl', labelColor: customLabelColor } = Astro.props;

const alignClass = align === 'left' ? 'text-left' : 'text-center';
const titleColor = dark ? 'text-white' : 'text-text-main';
const subtitleColor = dark ? 'text-white/60' : 'text-text-soft';
const labelColor = customLabelColor || (dark ? 'text-primary/80' : 'text-primary');
---

<div class={`${alignClass} mb-12 md:mb-16 lg:mb-20`} data-animate>
  {label && (
    <p class={`label-tag ${labelColor} mb-4`}>{label}</p>
  )}
  <h2 class={`font-serif text-display-lg ${titleColor} ${titleMaxWidth} ${align === 'center' ? 'mx-auto' : ''} mb-5`}>
    <Fragment set:html={title} />
  </h2>
  {subtitle && (
    <p class={`font-sans text-lg ${subtitleColor} max-w-2xl ${align === 'center' ? 'mx-auto' : ''}`}>
      {subtitle}
    </p>
  )}
</div>
