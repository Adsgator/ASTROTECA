---
import { Image } from "astro:assets";

interface Props {
  name: string;
  rating: number;
  text: string;
  image: ImageMetadata;
  date?: string;
}

const { name, rating, text, image } = Astro.props;
const stars = Array(rating).fill('★').join('');
---

<div class="bg-background border border-border rounded-lg p-6 flex flex-col gap-4 hover:shadow-card transition-all duration-200 h-full" data-animate-item>
  <div class="flex items-center gap-3">
    <img src="/preview-assets/placeholder-hero.svg" alt="imagem" />
    <div>
      <p class="font-sans text-sm font-medium text-text-main">{name}</p>
      <div class="text-secondary text-sm tracking-wider" aria-label={`${rating} estrelas`}>{stars}</div>
    </div>
  </div>
  <p class="font-sans text-sm text-text-soft leading-relaxed italic">"{text}"</p>
</div>
