---
import SectionHeader from '../Other/SectionHeader6412.astro';
import ReviewCard from '../Other/ReviewCard2893.astro';





/**
 * ⚠️ CRÍTICO — DADOS REAIS NECESSÁRIOS
 * Os textos abaixo são PLACEHOLDERS VAZIOS.
 * ANTES do go-live, substituir pelos textos REAIS extraídos manualmente
 * do Google Business de Ana Ester em: https://g.page/r/ana-ester-nutricionista
 *
 * NUNCA inventar avaliações — usar APENAS textos reais dos clientes.
 * Extrair: nome completo/anônimo, rating (1-5), texto exato, data relativa
 */
const reviews = [
  {
    name: "Letícia Arantes",
    rating: 5,
    text: "Profissional incrível, muito didática e cuidadosa, sempre adapta as dietas para se encaixar da melhor maneira possível nas rotinas e necessidades do paciente. Recomendo!",
    image: leticiaImg,
  },
  {
    name: "Angela Dos Santos Botelhos",
    rating: 5,
    text: "Ana Ester é uma excelente profissional, muito atenciosa, dedicada e sempre disposta a esclarecer todas as dúvidas. Sou sua paciente há anos e só tenho que agradecer por todo suporte desolvido nesses anos. Sempre a indico para amigos e conhecidos.",
    image: angelaImg,
  },
  {
    name: "Gustavo gut",
    rating: 5,
    text: "Excelente profissional, recomendo de olhos fechados. Atenciosa, dedicada e muito coerente com os atendimentos.",
    image: gustavoImg,
  },
  {
    name: "daiza thezolin",
    rating: 5,
    text: "Excelente profissional, sempre cuidadosa com cada paciente, vendo a particularidade de cada um. Dietas que encaixa perfeitamente, sem passar fome e respeitando cada momento que estamos passando. Super recomendo a Ana 🥰🥰",
    image: daizaImg,
  },
  {
    name: "Andreza Cristina dos Santos",
    rating: 5,
    text: "Excelente profissional; prescreve as dietas de acordo com as necessidades dos pacientes; analisa exames laboratoriais e ajusta as suplementações necessárias. É solicita quando há duvidas sendo prontamente respondidas por mensagem.",
    image: andrezaImg,
  },
];
---

<section
  id="avaliacoes"
  class="bg-background section-py"
  aria-labelledby="avaliacoes-heading"
>
  <div class="container-wide">
    <SectionHeader
      label="Avaliações"
      title="O que pacientes dizem no Google"
      subtitle="5,0 estrelas com 16 avaliações verificadas"
      labelColor="text-secondary"
    />

    <!-- Badge Google com destaque -->
    <div class="flex justify-center mb-12" data-animate>
      <a
        href="https://maps.app.goo.gl/QrsQDtMMypFogK5MA"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-4 border border-primary/20 rounded-xl px-6 py-4 bg-gradient-to-r from-white to-primary/5 shadow-card transition-all hover:shadow-lg hover:border-primary/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-label="Ver avaliações do Google Business"
      >
        <!-- Logo Google -->
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            fill="#4285F4"></path>
          <path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path>
          <path
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            fill="#FBBC05"></path>
          <path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            fill="#EA4335"></path>
        </svg>

        <div class="w-px h-12 bg-border" aria-hidden="true"></div>

        <div class="text-left">
          <span
            class="font-sans text-sm font-semibold text-text-main block leading-tight"
            >Excelente</span
          >
          <span class="font-sans text-xs text-text-muted">Google Business</span>
        </div>

        <div class="flex items-center gap-2">
          <span
            class="text-secondary text-base tracking-wide"
            aria-label="5 estrelas">★★★★★</span
          >
          <span class="font-sans text-sm font-semibold text-text-main">5.0</span
          >
          <span class="font-sans text-xs text-text-muted">(16)</span>
        </div>
      </a>
    </div>

    <!-- Carrossel infinito com drag fluido -->
    <div
      class="relative overflow-hidden"
      data-animate-group
      role="region"
      aria-label="Carrossel de avaliações dos pacientes"
    >
      <!-- Degrade esquerdo -->
      <div
        class="absolute left-0 top-0 bottom-0 w-16 lg:w-24 bg-gradient-to-r from-background to-transparent pointer-events-none z-20"
        aria-hidden="true"
      >
      </div>
      <!-- Degrade direito -->
      <div
        class="absolute right-0 top-0 bottom-0 w-16 lg:w-48 bg-gradient-to-l from-background to-transparent pointer-events-none z-20"
        aria-hidden="true"
      >
      </div>

      <div class="flex items-stretch gap-6 pb-4" data-carousel-track>
        <!-- Cards originais + duplicados para loop infinito -->
        {
          [...reviews, ...reviews].map((review, idx) => (
            <div
              class="flex-shrink-0 w-[85vw] md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]"
              aria-hidden={idx >= reviews.length ? "true" : "false"}
            >
              <ReviewCard
                name={review.name}
                rating={review.rating}
                text={review.text}
                image={review.image}
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Link para o perfil Google -->
    <p class="text-center mt-8 font-sans text-sm text-text-muted" data-animate>
      Veja todas as avaliações no
      <a
        href="https://maps.app.goo.gl/QrsQDtMMypFogK5MA"
        target="_blank"
        rel="noopener noreferrer"
        class="text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        Google Business
      </a>
    </p>
  </div>
</section>

<script>
  const track = document.querySelector("[data-carousel-track]") as HTMLElement;
  const container = track?.parentElement as HTMLElement;

  if (track && container) {
    const TOTAL_CARDS = track.children.length; // Originais + duplicados
    const ORIGINAL_COUNT = TOTAL_CARDS / 2;
    const GAP = 24; // gap-6 = 1.5rem = 24px

    let offset = 0; // Posição atual em px
    let velocity = 0; // Velocidade atual
    let isDragging = false;
    let startX = 0;
    let startOffset = 0;
    let lastX = 0;
    let lastTime = 0;
    let rafId: number;

    // Calcula largura de um card baseada no container
    const getCardWidth = () => {
      const card = track.children[0] as HTMLElement;
      return card ? card.offsetWidth + GAP : 0;
    };

    // Aplica offset via transform (sem reflow)
    const applyOffset = () => {
      track.style.transform = `translateX(${-offset}px)`;
    };

    // Loop infinito: quando passa metade, teleporta silenciosamente
    const clampLoop = () => {
      const cardWidth = getCardWidth();
      const loopLength = cardWidth * ORIGINAL_COUNT;

      if (offset >= loopLength) {
        offset -= loopLength;
        applyOffset();
      } else if (offset < 0) {
        offset += loopLength;
        applyOffset();
      }
    };

    // Loop de inércia
    const tick = () => {
      if (!isDragging && Math.abs(velocity) > 0.01) {
        offset += velocity;
        velocity *= 0.94; // friction
        clampLoop();
        applyOffset();
        rafId = requestAnimationFrame(tick);
      }
    };

    // Mouse events
    const onMouseDown = (e: MouseEvent) => {
      isDragging = true;
      startX = e.clientX;
      startOffset = offset;
      lastX = e.clientX;
      lastTime = Date.now();
      velocity = 0;
      cancelAnimationFrame(rafId);
      container.style.cursor = "grabbing";
    };

    const onMouseMove = (e: MouseEvent) => {
      if (!isDragging) return;

      const now = Date.now();
      const dt = Math.max(now - lastTime, 1);
      const dx = e.clientX - lastX;

      velocity = (-dx / dt) * 14; // Sensibilidade do arrasto
      offset = startOffset - (e.clientX - startX);
      clampLoop();
      applyOffset();

      lastX = e.clientX;
      lastTime = now;
    };

    const onMouseUp = () => {
      if (!isDragging) return;
      isDragging = false;
      container.style.cursor = "grab";
      rafId = requestAnimationFrame(tick);
    };

    // Touch events (mobile)
    const onTouchStart = (e: TouchEvent) => {
      startX = e.touches[0].clientX;
      startOffset = offset;
      lastX = e.touches[0].clientX;
      lastTime = Date.now();
      velocity = 0;
      cancelAnimationFrame(rafId);
    };

    const onTouchMove = (e: TouchEvent) => {
      const now = Date.now();
      const dt = Math.max(now - lastTime, 1);
      const dx = e.touches[0].clientX - lastX;

      velocity = (-dx / dt) * 14;
      offset = startOffset - (e.touches[0].clientX - startX);
      clampLoop();
      applyOffset();

      lastX = e.touches[0].clientX;
      lastTime = now;
    };

    const onTouchEnd = () => {
      rafId = requestAnimationFrame(tick);
    };

    container.addEventListener("mousedown", onMouseDown);
    container.addEventListener("mousemove", onMouseMove);
    container.addEventListener("mouseup", onMouseUp);
    container.addEventListener("mouseleave", onMouseUp);
    document.addEventListener("mouseup", onMouseUp);

    container.addEventListener("touchstart", onTouchStart, { passive: true });
    container.addEventListener("touchmove", onTouchMove, { passive: true });
    container.addEventListener("touchend", onTouchEnd);

    // Init
    applyOffset();
    container.style.cursor = "grab";
    track.style.willChange = "transform";
  }
</script>

<style>
  [data-carousel-track] {
    display: flex;
    gap: 1.5rem;
    will-change: transform;
    user-select: none;
  }
</style>
