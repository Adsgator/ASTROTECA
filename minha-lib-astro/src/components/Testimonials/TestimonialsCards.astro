---
// src/components/Testimonials/TestimonialsCards.astro

interface Testimonial {
  quote: string
  author: string
  role: string
  avatar?: string
}

interface Props {
  sectionTitle?: string
  testimonials: Testimonial[]
}

const { sectionTitle = "O que dizem nossos clientes", testimonials } = Astro.props
---

<section class="py-24 px-6 max-w-content mx-auto bg-surface-alt">
  <h2 class="font-serif text-[clamp(1.75rem,4vw,2.5rem)] text-text-main text-center mb-12">
    {sectionTitle}
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {testimonials.map((t) => (
      <div class="bg-surface rounded-2xl p-6 shadow-card">
        <div class="text-4xl text-text-soft/30 mb-4">"</div>
        <p class="text-text-main leading-relaxed mb-6">{t.quote}</p>
        <div class="flex items-center gap-3">
          {t.avatar && (
            <img src={t.avatar} alt={t.author} class="w-12 h-12 rounded-full object-cover" />
          )}
          <div>
            <div class="font-semibold text-text-main">{t.author}</div>
            <div class="text-sm text-text-soft">{t.role}</div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
