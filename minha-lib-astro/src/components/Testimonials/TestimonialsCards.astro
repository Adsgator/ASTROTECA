---
// src/components/Testimonials/TestimonialsCards.astro

interface Testimonial {
  quote: string
  author: string
  role: string
  avatar?: string
}

interface Props {
  sectionTitle?: string
  testimonials: Testimonial[]
}

const { sectionTitle = "O que dizem nossos clientes", testimonials } = Astro.props
---

<section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8 xl:px-12 max-w-7xl mx-auto bg-gray-50">
  <h2 class="text-3xl sm:text-4xl font-bold text-center text-gray-900 mb-12">
    {sectionTitle}
  </h2>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {testimonials.map((t) => (
      <div class="bg-white rounded-2xl p-6 shadow-lg">
        <div class="text-4xl text-gray-300 mb-4">"</div>
        <p class="text-gray-700 leading-relaxed mb-6">{t.quote}</p>
        <div class="flex items-center gap-3">
          {t.avatar && (
            <img src={t.avatar} alt={t.author} class="w-12 h-12 rounded-full object-cover" />
          )}
          <div>
            <div class="font-semibold text-gray-900">{t.author}</div>
            <div class="text-sm text-gray-500">{t.role}</div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
