---
// src/components/Testimonials/TestimonialsCards.astro

interface Testimonial {
  quote: string
  author: string
  role: string
  avatar?: string
}

interface Props {
  sectionTitle?: string
  testimonials: Testimonial[]
}

const { sectionTitle = "O que dizem nossos clientes", testimonials } = Astro.props
---

<section class="py-24 px-6 max-w-[1200px] mx-auto bg-[var(--color-bg-secondary,#f8f8f8)]">
  <h2 class="font-[var(--font-heading,serif)] text-[clamp(1.75rem,4vw,2.5rem)] text-[var(--color-heading,#111)] text-center mb-12">
    {sectionTitle}
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {testimonials.map((t) => (
      <div class="bg-[var(--color-surface,#fff)] rounded-[var(--radius-lg,12px)] p-6 shadow-[0_4px_20px_rgba(0,0,0,0.08)]">
        <div class="text-4xl text-[var(--color-text-muted,#555)]/30 mb-4">"</div>
        <p class="text-[var(--color-text,#333)] leading-relaxed mb-6">{t.quote}</p>
        <div class="flex items-center gap-3">
          {t.avatar && (
            <img src={t.avatar} alt={t.author} class="w-12 h-12 rounded-full object-cover" />
          )}
          <div>
            <div class="font-semibold text-[var(--color-heading,#111)]">{t.author}</div>
            <div class="text-sm text-[var(--color-text-muted,#555)]">{t.role}</div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
