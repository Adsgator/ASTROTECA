---
// src/components/Pricing/PricingCards.astro

interface PricingPlan {
  name: string
  price: string
  period?: string
  features: string[]
  ctaLabel: string
  ctaHref: string
  highlighted?: boolean
}

interface Props {
  sectionTitle?: string
  plans: PricingPlan[]
}

const { sectionTitle = "Escolha seu plano", plans } = Astro.props
---

<section class="py-24 px-6 max-w-content mx-auto">
  {sectionTitle && (
    <h2 class="font-serif text-[clamp(1.75rem,4vw,2.5rem)] text-text-main text-center mb-4">
      {sectionTitle}
    </h2>
  )}

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
    {plans.map((plan) => (
      <div class={`rounded-2xl p-8 ${plan.highlighted ? 'bg-primary text-white shadow-primary-md scale-105' : 'bg-surface border border-border'}`}>
        <h3 class={`text-xl font-semibold mb-2 ${plan.highlighted ? 'text-white' : 'text-text-main'}`}>
          {plan.name}
        </h3>
        <div class="mb-6">
          <span class={`text-4xl font-bold ${plan.highlighted ? 'text-white' : 'text-text-main'}`}>{plan.price}</span>
          {plan.period && (
            <span class={`text-sm ${plan.highlighted ? 'text-white/80' : 'text-text-soft'}`}>/{plan.period}</span>
          )}
        </div>
        <ul class="space-y-3 mb-8">
          {plan.features.map((feature) => (
            <li class={`flex items-center gap-2 ${plan.highlighted ? 'text-white/90' : 'text-text-main'}`}>
              <span class={plan.highlighted ? 'text-white' : 'text-primary'}>✓</span>
              {feature}
            </li>
          ))}
        </ul>
        <a
          href={plan.ctaHref}
          class={`block w-full text-center py-3 rounded-lg font-semibold no-underline transition-opacity duration-200 hover:opacity-[0.88] ${
            plan.highlighted
              ? 'bg-surface text-primary'
              : 'bg-primary text-white'
          }`}
        >
          {plan.ctaLabel}
        </a>
      </div>
    ))}
  </div>
</section>
