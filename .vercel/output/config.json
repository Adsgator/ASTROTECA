{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/create-project\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/publish-component\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/builder\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/config\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/preview(?:\\/(.*?))?\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		}
	]
}